// ═══════════════════════════════════════════════════════════════════════
//  SPRINT 3: ACTION GENERATION — Intelligence → Outcomes
// ═══════════════════════════════════════════════════════════════════════
//
// ActionArtifact stores AI-generated action recommendations produced by
// the Sprint 3 action engine. Each record represents one of six action types:
//   1. meeting_prep       — Executive summary + talking points + discovery questions
//   2. executive_outreach  — Who to approach + why + personalized messaging
//   3. account_strategy    — Business priorities + solution alignment + risks
//   4. stakeholder_map     — Decision makers + influencers + relationship intel
//   5. opportunity_qual    — Buying signals + timing + strategic fit + confidence
//   6. next_best_action    — THE answer: "What should I do next and why?"
//
// Every recommendation is traceable to evidence (signal IDs, evidence IDs,
// contact IDs). AI interprets existing data — it never invents.

model ActionArtifact {
  id                    String   @id @default(cuid())
  companyId             String
  company               Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Which of the 6 action types this artifact represents
  actionType            String   // meeting_prep | executive_outreach | account_strategy | stakeholder_map | opportunity_qualification | next_best_action

  // Executive summary — 2-3 sentence TL;DR of the action
  summary               String

  // Full structured output — JSON with action-type-specific schema
  // meeting_prep:       { executiveSummary, keyChanges, talkingPoints, discoveryQuestions, icebreakers }
  // executive_outreach: { targets: [{ name, title, reason, approach, messaging }] }
  // account_strategy:   { priorities, solutionAlignment, risks, blockers, opportunityAreas }
  // stakeholder_map:    { decisionMakers, influencers, champions, relationships }
  // opportunity_qual:   { buyingSignals, timing, strategicFit, confidenceScore, verdict }
  // next_best_action:   { action, reason, urgency, effort, expectedOutcome, evidenceLinks }
  content               Json   // JSON: structured output with action-type-specific schema

  // Priority scoring
  priorityScore         Int      @default(0)  // 0-100
  confidence            Float    @default(0)  // 0-1

  // Evidence traceability — every claim links back to source data
  // JSON: [{ type: "signal"|"evidence"|"contact"|"insight", id: string, snippet: string }]
  evidenceReferences    Json   @default("[]")

  // How many source signals/artifacts fed into this generation
  sourceSignalCount     Int      @default(0)
  sourceContactCount    Int      @default(0)

  // Lifecycle
  status                String   @default("draft") // draft | approved | executed | expired | superseded
  expiresAt             DateTime?
  generatedBy           String   @default("sprint3_engine")
  generatedAt           DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([companyId])
  @@index([actionType])
  @@index([companyId, actionType])
  @@index([priorityScore(sort: Desc)])
  @@index([status])
  @@index([generatedAt(sort: Desc)])
  @@index([expiresAt])
}

// ─── Phase B Engine Architecture Models ──────────────────────────────────
// Added for the unified engine architecture (ModelRouter + GroundingEngine +
// RetrievalEngine + 4 composition engines). These support:
//   1. Embedding persistence for RetrievalEngine (semantic search)
//   2. EngineRun audit trail for composition engines (one row per
//      composition-level call, links to AIGenerationAudit at the LLM-call
//      level via llmCallCount + llmTokensUsed + llmCostUsd aggregates)

model Embedding {
  id          String   @id @default(cuid())
  // What this embedding represents: 'capability_asset', 'ai_insight',
  // 'company_signal', 'company', 'contact', 'opportunity', etc.
  entityType  String
  // Stable ID of the entity this embedding represents (e.g. 'cap_xyz')
  entityId    String   @unique
  // The source text that was embedded (for re-embedding if model changes)
  sourceText  String  
  // SHA-256 of sourceText — used to detect stale embeddings that need refresh
  textHash    String
  // The embedding vector serialized as JSON string (e.g. "[0.1,0.2,...]")
  // Stored as Text rather than a native vector type because we don't depend
  // on pgvector — cosine similarity is computed in JS after parsing.
  vector      String  
  // Which model produced this embedding (e.g. 'Xenova/all-MiniLM-L6-v2')
  model       String
  // Vector dimensionality (e.g. 384 for all-MiniLM-L6-v2)
  dimensions  Int

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([entityType])
  @@index([entityId])
  @@index([model])
}

model EngineRun {
  id              String   @id @default(cuid())
  // Which composition engine ran: 'synthesis', 'scoring', 'action', 'conversation'
  engine          String
  // Composition ID — links related runs (e.g. one compositionId per chat session)
  compositionId   String?
  // Brief summary of the input (JSON: { briefType, companyId, ... })
  inputSummary    Json
  // Brief summary of the output (JSON: { wordCount, confidence, ... })
  outputSummary   Json  
  // Engine-level confidence (0-1)
  confidence      Float    @default(0)
  // Wall-clock duration
  durationMs      Int
  // Whether the engine returned success=true
  success         Boolean  @default(true)
  // Error message if !success
  errorMessage    String?

  // Context entities (nullable — not all runs target a specific entity)
  companyId       String?
  contactId       String?
  opportunityId   String?

  // Aggregate LLM stats for this composition run (links to AIGenerationAudit
  // at the per-call level — one EngineRun may include multiple LLM calls
  // across Deep/Smart/Fast tiers)
  llmCallCount    Int      @default(0)
  llmTokensUsed   Int      @default(0)
  llmCostUsd      Float    @default(0)

  createdAt       DateTime @default(now())

  @@index([engine])
  @@index([compositionId])
  @@index([companyId])
  @@index([contactId])
  @@index([createdAt(sort: Desc)])
}

// ═══════════════════════════════════════════════════════════════════════
//  PHASE 9: ENTERPRISE REASONING ENGINE — Cumulative Reasoning Context
// ═══════════════════════════════════════════════════════════════════════
//
// Instead of running isolated pipeline stages, DeepMindQ now builds a
// CUMULATIVE reasoning context per company. Each step reasons on top of
// all previous steps. The full context is persisted and reused.
//
// THE REASONING CHAIN (30+ steps):
//   1-3:   Company Profile → Industry Context → Market Position
//   4-6:   Technology Landscape → Existing Vendors → Digital Maturity
//   7-9:   Funding & Financials → Growth Trajectory → Risk Signals
//   10-12: Leadership & Org → Buying Committee Map → Key Decision Makers
//   13-15: Strategic Initiatives → Pain Areas → Business Problems
//   16-18: Signal Analysis → Signal Meaning → Opportunity Windows
//   19-21: Internal Capability Match → Case Study Match → Accelerator Match
//   22-24: Delivery Experience → Pricing Alignment → Proposal Components
//   25-27: Win Probability → Competitive Position → Objection Prep
//   28-30: Conversation Strategy → Next Best Action → Engagement Plan
// ═══════════════════════════════════════════════════════════════════════

model ReasoningContext {
  id                 String   @id @default(cuid())
  companyId          String   @unique
  company            Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // The cumulative reasoning state — JSON blob containing the full
  // reasoning chain with each step's output and evidence references.
  // Structure: { steps: [{ id, name, output, evidence, confidence }], summary }
  reasoningState     Json    @default("{}")

  // High-level derived outputs (computed from reasoning state)
  overallConfidence  Float    @default(0)       // 0-1 composite confidence
  winProbability     Float?                     // 0-1 estimated win probability
  opportunityScore   Float?                     // 0-100 composite opportunity score
  recommendedActions Json    @default("[]")    // JSON: [{ action, reason, priority, timing }]
  matchedCapabilities Json    @default("[]")   // JSON: [{ capabilityId, score, reason }]
  matchedCaseStudies Json    @default("[]")   // JSON: [{ caseStudyId, relevance, outcome }]
  competitivePosition Json    @default("{}")  // JSON: { position, strengths, weaknesses, threats }

  // Pipeline metadata
  status             String   @default("empty") // empty | building | ready | stale | failed
  totalSteps         Int      @default(0)       // completed reasoning steps
  totalAIcalls       Int      @default(0)       // AI calls made
  totalTokensUsed    Int      @default(0)
  totalCostUsd       Float    @default(0)
  buildDurationMs    Int?                        // total build time

  // Freshness — auto-stale after 7 days, re-buildable on demand
  builtAt            DateTime?
  staleAt            DateTime?
  lastRebuiltAt      DateTime?

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  steps              ReasoningStep[]
  agentOrchestrations AgentOrchestration[]

  @@index([companyId])
  @@index([status])
  @@index([overallConfidence])
  @@index([builtAt])
  @@index([staleAt])
}

model ReasoningStep {
  id                 String   @id @default(cuid())
  reasoningContextId String
  reasoningContext   ReasoningContext @relation(fields: [reasoningContextId], references: [id], onDelete: Cascade)

  // Step identity
  stepNumber         Int                        // ordered position in reasoning chain
  stepName           String                     // e.g. "company_profile", "signal_analysis", "capability_match"
  stepGroup          String                     // external_intel | internal_match | fusion | strategy

  // Step output — what this step concluded
  output             Json                       // JSON: the structured output of this step
  summary            String?                    // human-readable 1-2 sentence summary

  // Evidence — what this step used
  evidenceIds        Json     @default("[]")    // JSON: string[] — IDs of evidence used
  knowledgeIds       Json     @default("[]")    // JSON: string[] — IDs of CapabilityAssets referenced

  // Confidence & cost
  confidence         Float    @default(0.5)      // 0-1 confidence in this step's output
  aiCalls            Int      @default(0)
  tokensUsed         Int      @default(0)
  costUsd            Float    @default(0)
  durationMs         Int?

  // Dependencies — this step reads output from previous steps
  dependsOnSteps     Json     @default("[]")    // JSON: stepNumber[] — which steps this builds on

  createdAt          DateTime @default(now())

  @@unique([reasoningContextId, stepNumber])
  @@index([reasoningContextId])
  @@index([stepName])
  @@index([stepGroup])
  @@index([confidence])
}

// ═══════════════════════════════════════════════════════════════════════
//  PHASE 10: MULTI-AGENT ORCHESTRATION
// ═══════════════════════════════════════════════════════════════════════
//
// Coordinates specialist agents to work together on a single company
// analysis. Each agent is a specialist (Research, Capability Matching,
// Scoring, Strategy, etc.) that contributes to the shared ReasoningContext.
//
// KEY DESIGN: Agents share ONE ReasoningContext. They read from it and
// write to it. No duplicate AI calls. No disconnected workflows.
// ═══════════════════════════════════════════════════════════════════════

model AgentOrchestration {
  id                  String   @id @default(cuid())
  companyId           String
  company             Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  reasoningContextId  String?  // links to the shared ReasoningContext
  reasoningContext    ReasoningContext? @relation(fields: [reasoningContextId], references: [id], onDelete: SetNull)

  // Orchestration metadata
  triggerType         String   @default("manual") // manual | signal_detected | scheduled | enrichment
  triggerSignalId     String?  // which signal triggered this orchestration
  status              String   @default("pending") // pending | running | completed | failed | cancelled

  // Agent execution plan — JSON: [{ agent, step, dependsOn, status }]
  executionPlan       String   @default("[]")

  // Aggregate stats
  totalAgents        Int      @default(0)
  completedAgents     Int      @default(0)
  failedAgents        Int      @default(0)
  totalDurationMs     Int      @default(0)
  totalAIcalls        Int      @default(0)
  totalTokensUsed     Int      @default(0)
  totalCostUsd        Float    @default(0)

  // Output reference
  outputSummary       Json    @default("{}") // JSON: summary of orchestration output

  startedAt           DateTime?
  completedAt         DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  agentRuns           AgentRun[]

  @@index([companyId])
  @@index([status])
  @@index([triggerType])
  @@index([createdAt])
}

model AgentRun {
  id                  String   @id @default(cuid())
  orchestrationId     String
  orchestration       AgentOrchestration @relation(fields: [orchestrationId], references: [id], onDelete: Cascade)

  // Agent identity
  agentName           String   // research | capability_matcher | scorer | strategist | conversation | proposal | executive_brief | fusion | learning | health_check
  agentType           String   // foundation | composition | specialist

  // Agent task
  task                String   // what this agent was asked to do
  inputContext        Json    @default("{}") // JSON: context from ReasoningContext used as input
  output              Json?  // JSON: agent's structured output

  // Execution
  status              String   @default("pending") // pending | running | completed | failed | skipped
  dependsOn           Json    @default("[]") // JSON: agentName[] — which agents must complete first

  // Cost tracking
  aiCalls             Int      @default(0)
  tokensUsed          Int      @default(0)
  costUsd             Float    @default(0)
  durationMs          Int?

  // Errors
  error               String?

  startedAt           DateTime?
  completedAt         DateTime?
  createdAt           DateTime @default(now())

  @@index([orchestrationId])
  @@index([agentName])
  @@index([status])
  @@index([createdAt])
}

// ═══════════════════════════════════════════════════════════════════════
//  PHASE 11: AI COST OPTIMIZATION — Response Caching
// ═══════════════════════════════════════════════════════════════════════
//
// Caches AI responses keyed by prompt hash + context hash.
// Before making any AI call, check cache first.
// Reduces NVIDIA/Tavily/LLM costs by 60-80% for repeated analyses.
// ═══════════════════════════════════════════════════════════════════════

model AICache {
  id              String   @id @default(cuid())
  // SHA-256 hash of (systemPrompt + userPrompt + contextFingerprint)
  cacheKey        String   @unique
  // What was cached
  systemPrompt    String
  userPrompt      String
  contextHash     String   // hash of the context data used (companyId + signals + evidence)
  response        String   // the LLM response text
  modelUsed       String
  tier            String   // deep | smart | fast

  // Cost savings
  tokensUsed      Int      @default(0)
  costUsd         Float    @default(0)
  hitCount        Int      @default(0) // how many times this cache was hit
  lastHitAt       DateTime?

  // TTL — cache expires after 7 days for signals, 30 days for static knowledge
  expiresAt       DateTime
  createdAt       DateTime @default(now())

  @@index([cacheKey])
  @@index([expiresAt])
  @@index([modelUsed])
  @@index([hitCount(sort: Desc)])
}

// ═══════════════════════════════════════════════════════════════════════
//  PHASE 12: CONTINUOUS LEARNING LOOP
// ═══════════════════════════════════════════════════════════════════════
//
// Every interaction (win, loss, feedback, email reply, meeting note)
// creates a LearningEvent that updates the organizational memory.
// Knowledge from HSBC engagement auto-reusable for next bank prospect.
// ═══════════════════════════════════════════════════════════════════════

model LearningEvent {
  id                String   @id @default(cuid())
  companyId         String?
  company           Company?  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // What happened
  eventType         String   // win | loss | feedback_positive | feedback_negative | email_replied | meeting_held | proposal_sent | objection_raised | competitive_loss | new_case_study | methodology_improved | pricing_updated | lesson_learned
  source            String   // system | user | ai_recommendation | email | calendar
  description       String   // what happened

  // What was learned
  learnedInsight    String   // the extracted insight / lesson
  applicableContext String   @default("{}") // JSON: { industry, companySize, technology, role, serviceLine } — when this learning applies
  applicableTags    String   @default("[]") // JSON: string[] — tags for matching

  // Knowledge creation — did this event create new organizational knowledge?
  createdCapabilityAssetId String? // if this created a new CapabilityAsset
  updatedCapabilityAssetId String? // if this updated an existing one

  // Quality
  confidence        Float    @default(0.5) // 0-1 how confident we are in this learning
  verified          Boolean  @default(false) // has a human verified this learning?

  // Reusability tracking
  reuseCount        Int      @default(0) // how many times this learning was reused
  lastReusedAt      DateTime?

  // Feedback on the learning itself
  feedback          String?  // positive | negative | needs_refinement
  feedbackNote      String?

  createdAt         DateTime @default(now())

  @@index([companyId])
  @@index([eventType])
  @@index([confidence])
  @@index([reuseCount(sort: Desc)])
  @@index([verified])
  @@index([createdAt])
}

// ═══════════════════════════════════════════════════════════════════════
//  PHASE 13: KNOWLEDGE CHUNKING — Document Ingestion Pipeline
// ═══════════════════════════════════════════════════════════════════════
//
// When documents (proposals, whitepapers, case studies, emails, etc.)
// are uploaded, they're chunked, classified, summarized, embedded,
// and linked to the knowledge graph. Each chunk is independently
// searchable and retrievable.
// ═══════════════════════════════════════════════════════════════════════

model KnowledgeDocument {
  id                String   @id @default(cuid())
  title             String
  documentType      String   // proposal | whitepaper | case_study | email | meeting_note | rfp_response | sales_deck | methodology | architecture_doc | competitive_report
  sourceUrl         String?
  sourceType        String   @default("upload") // upload | email | crm | website | manual
  originalContent   String   // full original text
  contentHash       String   // SHA-256 for dedup detection
  metadata          String   @default("{}") // JSON: { author, date, client, project, industry, technology }

  // Processing status
  status            String   @default("pending") // pending | extracting | chunking | classifying | embedding | linking | completed | failed
  processingError   String?
  totalChunks       Int      @default(0)
  processedChunks   Int      @default(0)

  // Link to parent CapabilityAsset (if this document IS a capability)
  capabilityAssetId String?
  capabilityAsset   CapabilityAsset? @relation(fields: [capabilityAssetId], references: [id], onDelete: SetNull)

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  chunks            KnowledgeChunk[]

  @@index([documentType])
  @@index([status])
  @@index([contentHash])
  @@index([capabilityAssetId])
  @@index([createdAt])
}

model KnowledgeChunk {
  id                String   @id @default(cuid())
  documentId        String
  document          KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  // Chunk content
  chunkIndex        Int                          // position within document
  content           String                       // the chunk text
  summary           String?                      // AI-generated summary
  keywords          String   @default("[]")       // JSON: string[] — extracted keywords

  // Classification
  category          String?                      // knowledge category (service_line, case_study, etc.)
  subCategory       String?                      // finer classification
  industry          String?                      // applicable industry
  technology        String?                      // applicable technology
  relevanceScore    Float    @default(0.5)       // 0-1 how relevant this chunk is

  // Embedding reference
  embeddingId       String?                      // links to Embedding table
  contentHash       String                       // SHA-256 for cache/dedup

  // Metadata
  metadata          String   @default("{}")      // JSON: { page, section, speaker, topic }

  createdAt         DateTime @default(now())

  @@index([documentId])
  @@index([chunkIndex])
  @@index([category])
  @@index([industry])
  @@index([technology])
  @@index([embeddingId])
  @@index([contentHash])
  @@unique([documentId, chunkIndex])
}

// ═══════════════════════════════════════════════════════════════════════
//  PHASE 9: PIPELINE EXECUTION TRACKING & COST ACCOUNTING
// ═══════════════════════════════════════════════════════════════════════

// Stores the execution record of every pipeline run for a company.
// Enables cost tracking, dedup detection, and performance monitoring.

model PipelineRun {
  id                String   @id @default(cuid())
  companyId         String
  company           Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Execution metadata
  pipelineType      String   @default("full")       // full | enrich | capability_only | fusion
  status            String   @default("running")    // running | completed | failed | partial

  // Stage tracking
  totalStages       Int      @default(16)
  completedStages  Int      @default(0)
  failedStages      Int      @default(0)
  skippedStages     Int      @default(0)

  // Stage results (JSON: StageResult[])
  stageResults      String   @default("[]")

  // Cost tracking
  aiCallsMade       Int      @default(0)
  tavilyCallsMade   Int      @default(0)
  embeddingCallsMade Int    @default(0)
  estimatedCostUsd  Float    @default(0)
  totalTokensUsed   Int      @default(0)

  // Timing
  startedAt         DateTime @default(now())
  completedAt       DateTime?
  durationMs        Int?

  // Output references
  accountBriefId    String?
  accountScoreId    String?
  strategicInsightId String?

  // Phase 1.3: @relation back-field
  aiCallLogs AICallLog[]

  @@index([companyId])
  @@index([status])
  @@index([startedAt])
  @@index([companyId, startedAt])
}

// ═══════════════════════════════════════════════════════════════════════
//  PHASE 10: INTELLIGENCE FUSION LAYER
// ═══════════════════════════════════════════════════════════════════════

// Records the fusion of external intelligence (signals, evidence) with
// internal intelligence (capabilities, case studies) to produce opportunity intelligence.
// This is the "external × internal = opportunity" equation.

model FusionResult {
  id                String   @id @default(cuid())
  companyId         String
  company           Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // What was fused
  signalIds         Json    @default("[]")    // JSON: string[]
  capabilityIds     Json    @default("[]")    // JSON: string[]
  evidenceIds       Json    @default("[]")    // JSON: string[]

  // Fusion output
  fusionType        String                     // signal_capability | evidence_case_study | signal_solution | full_fusion
  fusionScore       Float    @default(0)       // 0-1 overall alignment score
  businessProblem   String?                     // identified business problem
  recommendedCapability String?                // which capability to position
  relevantCaseStudy String?                   // which case study to reference
  proofPoints       Json    @default("[]")    // JSON: string[] — supporting proof points

  // Explainability
  reasoningChain    Json    @default("[]")    // JSON: { step, input, output, confidence }[]
  confidenceScore   Float    @default(0)       // 0-1
  evidenceStrength  Float    @default(0)       // 0-1

  // Status
  status            String   @default("active") // active | consumed | expired
  expiresAt         DateTime?

  createdAt         DateTime @default(now())

  @@index([companyId])
  @@index([fusionType])
  @@index([fusionScore])
  @@index([status])
  @@index([companyId, fusionType])
}

// ═══════════════════════════════════════════════════════════════════════
//  PHASE 11: AI COST TRACKING & BUDGET
// ═══════════════════════════════════════════════════════════════════════

// Tracks every AI call for cost accounting and budget enforcement.

model AICallLog {
  id                String   @id @default(cuid())

  // What was called
  provider          String                     // gemini | groq | zai | nvidia
  model             String                     // specific model name
  tier              String                     // deep | smart | fast
  genType           String                     // company_enrichment | capability_matching | etc.

  // Attribution
  companyId         String?
  contactId         String?
  pipelineRunId     String?

  // Token usage
  promptTokens      Int      @default(0)
  completionTokens  Int      @default(0)
  totalTokens       Int      @default(0)

  // Cost
  estimatedCostUsd  Float    @default(0)

  // Outcome
  success           Boolean  @default(true)
  error             String?
  durationMs        Int?

  // Cache
  wasCached         Boolean  @default(false)

  createdAt         DateTime @default(now())

  // Phase 1.3: @relation for FK fields
  company     Company?     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contact     Contact?     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  pipelineRun PipelineRun? @relation(fields: [pipelineRunId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([genType])
  @@index([provider])
  @@index([createdAt])
  @@index([companyId, createdAt])
}

// ═══════════════════════════════════════════════════════════════════════
// Phase 9: Production Intelligence Layer — New Models
// ═══════════════════════════════════════════════════════════════════════

// DB-backed email templates (replaces filesystem custom-templates.json)
model CustomEmailTemplate {
  id          String   @id @default(cuid())
  name        String
  subject     String
  body        String
  category    String   @default("custom")
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// AI usage tracking — persist cost estimates from ai-caller
model AIUsageLog {
  id              String   @id @default(cuid())
  feature         String   // meeting-prep, nba, signal-classification, etc.
  provider        String   // nvidia, fireworks, groq, gemini
  model           String
  promptTokens    Int      @default(0)
  completionTokens Int     @default(0)
  totalTokens     Int      @default(0)
  estimatedCost   Float    @default(0)
  durationMs      Int      @default(0)
  companyId       String?
  userId          String?
  status          String   @default("success") // success, failed, degraded
  createdAt       DateTime @default(now())

  // Phase 1.3: @relation for FK fields
  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([feature])
  @@index([provider])
  @@index([companyId])
  @@index([createdAt])
}

// Intelligence action history — version tracking for recommendations
model IntelligenceActionHistory {
  id            String   @id @default(cuid())
  companyId     String
  actionType    String   // meeting_prep, next_best_action, account_strategy, etc.
  summary       String   // AI-generated summary
  content       String   // Full JSON content of the action
  confidence    Float    @default(0)
  signalCount   Int      @default(0)
  contactCount  Int      @default(0)
  evidenceIds   String   // JSON array of evidence/signal IDs referenced
  supersededAt  DateTime? // When a newer action replaced this one
  createdAt     DateTime @default(now())

  // Phase 1.3: @relation for FK field
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, actionType])
  @@index([companyId, createdAt])
  @@index([createdAt])
}

// Intelligence freshness tracking
model CompanyIntelligenceFreshness {
  id               String   @id @default(cuid())
  companyId        String   @unique
  lastRefreshAt    DateTime @default(now())
  lastSignalCount  Int      @default(0)
  lastEvidenceCount Int     @default(0)
  freshnessScore   Float    @default(1.0) // 1.0 = fresh, decays over time
  degradationLevel String   @default("fresh") // fresh, aging, stale
  nextRefreshAt    DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([freshnessScore])
  @@index([degradationLevel])
  @@index([nextRefreshAt])
}

// LinkedIn/People profile enrichment cache
model PeopleProfileEnrichment {
  id               String   @id @default(cuid())
  contactId        String   @unique
  linkedinUrl      String?
  headline         String?
  currentCompany   String?
  currentTitle     String?
  location         String?
  profileSummary   String?  // AI-generated summary of profile
  skills           String?  // JSON array of skills
  experienceHighlights String? // JSON array of key experiences
  sourceProvider   String?  // apollo, proxycurl, manual
  rawProfileData   String?  // Full raw response for re-processing
  enrichedAt       DateTime @default(now())
  confidenceScore  Float    @default(0)
  status           String   @default("pending") // pending, enriched, failed, outdated

  @@index([status])
  @@index([enrichedAt])
}

// Website change detection — page snapshots
model WebsiteSnapshot {
  id          String   @id @default(cuid())
  companyId   String
  pageUrl     String
  pageType    String   @default("homepage") // homepage, pricing, careers, about, blog
  contentHash String   // SHA-256 of page content for change detection
  contentText String?  // Extracted text content
  pageTitle   String?
  detectedChanges String? // JSON array of detected changes
  status      String   @default("active") // active, archived
  createdAt   DateTime @default(now())

  @@index([companyId, pageType])
  @@index([contentHash])
  @@index([createdAt])
}

// Competitive intelligence signals
model CompetitiveSignal {
  id              String   @id @default(cuid())
  competitorName  String
  eventTitle      String
  eventType       String  // product_launch, pricing_change, partnership, acquisition, hiring, leadership
  eventSummary    String
  sourceUrl       String?
  sourceName      String?
  detectedAt      DateTime @default(now())
  impactAnalysis  String? // AI analysis of which accounts this affects
  affectedAccounts String? // JSON array of company IDs that should see this signal
  status          String   @default("active") // active, processed, dismissed
  createdAt       DateTime @default(now())

  @@index([competitorName])
  @@index([eventType])
  @@index([status])
  @@index([createdAt])
}
