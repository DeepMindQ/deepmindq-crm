# ──────────────────────────────────────────────────────────────────────
#  DeepMindQ — Environment Variables
# ──────────────────────────────────────────────────────────────────────
# Copy this file to .env (local dev) OR paste these keys into Vercel
# Dashboard → Project → Settings → Environment Variables.
#
# All AI keys are OPTIONAL — engines degrade gracefully to template
# fallback if missing. Set what you have; the rest just won't run.
# ──────────────────────────────────────────────────────────────────────

# ── REQUIRED: Database (PostgreSQL) ──
# Get a free one from https://console.neon.tech (recommended for Vercel)
# Format: postgresql://user:pass@host/db?sslmode=require
DATABASE_URL=

# ── REQUIRED in production: Auth secret ──
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# ── Zero-budget AI providers (all optional, but recommended) ──
# Z.ai GLM-4.6 — Deep tier (long briefs, evidence synthesis)
# Get from: https://z.ai/ → API Keys
ZAI_API_KEY=
# Alt Z.ai auth (only if not using API key):
ZAI_BASE_URL=
ZAI_TOKEN=
ZAI_CHAT_ID=
ZAI_USER_ID=

# Google Gemini 2.0 Flash — Smart tier (scoring, structured outputs)
# Get from: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Groq Llama 3.3 70B / 3.1 8B — Fast tier (chat, actions, low-latency)
# Get from: https://console.groq.com/keys
GROQ_API_KEY=

# ── OPTIONAL: Transactional email ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── OPTIONAL: File attachments storage ──
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
