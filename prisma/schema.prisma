// ═══════════════════════════════════════════════════════════════════════════
// DeepMindQ — Enterprise Intelligence OS
// Data Model v1.0
//
// Mission: "Understand Before You Sell"
// This schema models intelligence entities, not CRM records.
// ═══════════════════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════════════════════════════════════
// Enums — SQLite stores enums as strings
// ═══════════════════════════════════════════════════════════════════════════

enum IntelligenceSource {
  upload
  crm
  manual
  external
  ai_inferred
  signal_detected
}

enum SignalType {
  hiring_change
  leadership_change
  technology_change
  funding_event
  market_expansion
  partnership
  competitor_move
  financial_indicator
  product_launch
  regulatory
  customer_signal
  social_mention
}

enum SignalSeverity {
  critical
  high
  medium
  low
}

enum SignalStatus {
  detected
  validated
  analyzed
  acted_upon
  expired
  dismissed
}

enum EvidenceReliability {
  verified
  likely
  inferred
  unverified
}

enum ConfidenceLevel {
  very_high
  high
  medium
  low
  very_low
}

enum OrgTrackingStatus {
  active
  paused
  archived
}

enum PersonRole {
  executive
  vice_president
  director
  manager
  individual
  advisor
  partner
  unknown
}

enum IngestionStatus {
  pending
  processing
  completed
  failed
  partial
  cancelled
}

enum IngestionFileType {
  csv
  xlsx
  xls
  json
}

// ═══════════════════════════════════════════════════════════════════════════
// Core Intelligence Entities
// ═══════════════════════════════════════════════════════════════════════════

/// Organization — An intelligence target (not a "Company" or "Account")
model Organization {
  id              String              @id @default(cuid())
  name            String
  domain          String?
  aliases         String              @default("[]")   // JSON-encoded string array (SQLite workaround — queried via resolveEntity() fuzzy match in KG engine)
  industry        String?
  subIndustry     String?
  description     String?
  website         String?
  headquarters    String?
  employeeCount   Int?
  revenue         String?
  foundedYear     Int?

  // Intelligence state
  trackingStatus  OrgTrackingStatus   @default(active)
  intelligenceScore Float?
  lastSignalAt    DateTime?
  lastEnrichedAt  DateTime?

  // Metadata
  sourceIngestionId String?

  source          IntelligenceSource  @default(manual)
  firstSeenAt     DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  // Relations
  people          Person[]
  signals         Signal[]
  evidence        Evidence[]
  insights        Insight[]
  briefings       Briefing[]
  dataIngestions  DataIngestionRow[]
  relationships   Relationship[]       @relation("OrgSourceRelationships")
  relationships2  Relationship[]       @relation("OrgTargetRelationships")
  signalRules      SignalRule[]

  @@index([domain])
  @@index([trackingStatus])
  @@index([intelligenceScore])
  @@index([lastSignalAt])
}

/// Person — A human intelligence node
model Person {
  id              String         @id @default(cuid())
  fullName        String
  email           String?
  title           String?
  role            PersonRole      @default(unknown)
  department      String?
  seniority       String?
  linkedInUrl     String?
  notes           String?

  organizationId  String?
  organization    Organization?   @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  sourceIngestionId String?

  source          IntelligenceSource @default(manual)
  firstSeenAt     DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  // Relations
  ingestionRows   DataIngestionRow[]

  relationships   Relationship[]   @relation("PersonSourceRelationships")
  relationships2  Relationship[]   @relation("PersonTargetRelationships")

  @@index([organizationId])
  @@index([fullName])
  @@index([email])
}

/// Relationship — Connection between entities in the knowledge graph
model Relationship {
  id          String   @id @default(cuid())
  type        String
  label       String?
  weight      Float    @default(1.0)

  sourceOrgId    String?
  sourceOrg      Organization?     @relation("OrgSourceRelationships", fields: [sourceOrgId], references: [id], onDelete: Cascade)
  targetOrgId    String?
  targetOrg      Organization?     @relation("OrgTargetRelationships", fields: [targetOrgId], references: [id], onDelete: Cascade)
  sourcePersonId String?
  sourcePerson   Person?          @relation("PersonSourceRelationships", fields: [sourcePersonId], references: [id], onDelete: Cascade)
  targetPersonId String?
  targetPerson   Person?          @relation("PersonTargetRelationships", fields: [targetPersonId], references: [id], onDelete: Cascade)

  evidenceId      String?
  validFrom       DateTime?
  validUntil      DateTime?
  sourceType      String?    @default("manual")   // 'manual' | 'signal_detected' | 'ai_inferred' | 'imported'
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([sourceOrgId])
  @@index([targetOrgId])
  @@index([sourcePersonId])
  @@index([targetPersonId])
}

// ═══════════════════════════════════════════════════════════════════════════
// Signal Intelligence
// ═══════════════════════════════════════════════════════════════════════════

/// Signal — A detected business event or pattern
model Signal {
  id              String          @id @default(cuid())
  organizationId  String
  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  signalType      SignalType
  severity        SignalSeverity  @default(medium)
  status          SignalStatus    @default(detected)

  title           String
  description     String
  rawContent      String?

  confidenceScore Float?
  impactScore     Float?

  detectedAt      DateTime        @default(now())
  eventDate       DateTime?
  expiresAt       DateTime?

  source          IntelligenceSource @default(signal_detected)
  sourceUrl       String?
  sourceLabel     String?

  analyzedAt      DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  evidence        Evidence[]
  insights        Insight[]
  events          SignalEvent[]

  @@index([organizationId])
  @@index([signalType])
  @@index([severity])
  @@index([status])
  @@index([detectedAt])
  @@index([organizationId, detectedAt])
}

/// SignalRule — Configuration for signal detection filtering
model SignalRule {
  id                  String   @id @default(cuid())
  name                String
  signalType          String
  enabled             Boolean  @default(true)
  severityThreshold   Int      @default(0)    // 0=all, 50=medium+, 70=high+
  customConditions    String?                     // JSON-encoded rule conditions (flexible per-signal-type config)
  organizationId      String?                     // null = global rule
  organization        Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy           String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([signalType])
  @@index([organizationId])
}

/// Evidence — Source backing an intelligence claim
model Evidence {
  id              String              @id @default(cuid())
  signalId        String?
  signal          Signal?             @relation(fields: [signalId], references: [id], onDelete: Cascade)
  organizationId  String
  organization    Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  claim           String
  sourceType      String
  sourceUrl       String?
  sourceTitle     String?
  sourceDate      DateTime?
  excerpt         String?

  reliability     EvidenceReliability @default(unverified)

  createdAt       DateTime            @default(now())

  @@index([signalId])
  @@index([organizationId])
  @@index([reliability])
}

/// SignalEvent — Audit trail for signal status transitions
model SignalEvent {
  id          String   @id @default(cuid())
  signalId    String
  signal      Signal   @relation(fields: [signalId], references: [id], onDelete: Cascade)
  fromStatus  String
  toStatus    String
  userId      String?
  reason      String?
  createdAt   DateTime @default(now())

  @@index([signalId])
  @@index([createdAt])
}

// ═══════════════════════════════════════════════════════════════════════════
// AI Intelligence Outputs
// ═══════════════════════════════════════════════════════════════════════════

/// Insight — AI-generated actionable intelligence
model Insight {
  id              String           @id @default(cuid())
  organizationId  String
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  signalId        String?
  signal          Signal?          @relation(fields: [signalId], references: [id], onDelete: Cascade)

  category        String
  title           String
  narrative       String
  recommendation  String?
  suggestedMessage String?

  confidence      ConfidenceLevel  @default(medium)
  confidenceScore Float?

  evidenceIds     String           @default("[]")   // JSON-encoded string array (cross-reference IDs — joined at query time via insight→evidence FK)
  signalIds       String           @default("[]")   // JSON-encoded string array (cross-reference IDs — joined at query time via insight→signal FK)

  reasoningMethod String
  modelUsed       String?
  promptVersion   String?

  status          String           @default("active")
  dismissedReason String?

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([organizationId])
  @@index([signalId])
  @@index([category])
  @@index([confidence])
  @@index([organizationId, createdAt])
}

/// Briefing — AI-generated intelligence summary per organization
model Briefing {
  id              String           @id @default(cuid())
  organizationId  String
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  executiveSummary String
  keyFindings     String           @default("[]")   // JSON-encoded string array (SQLite workaround — array of findings, parsed in briefing UI)
  opportunityScore Float?
  riskFactors     String           @default("[]")   // JSON-encoded string array (SQLite workaround — array of risks, parsed in briefing UI)
  recommendedActions String        @default("[]")   // JSON-encoded string array (SQLite workaround — array of actions, parsed in briefing UI)

  signalCount     Int              @default(0)
  activeSignals  Int              @default(0)
  insightCount    Int              @default(0)
  evidenceCount   Int              @default(0)

  overallConfidence ConfidenceLevel @default(medium)

  generatedAt     DateTime         @default(now())
  version         Int              @default(1)

  @@index([organizationId])
  @@index([organizationId, generatedAt])
}

// ═══════════════════════════════════════════════════════════════════════════
// Data Ingestion
// ═══════════════════════════════════════════════════════════════════════════

model DataIngestion {
  id              String              @id @default(cuid())
  fileName        String
  fileSize        Int
  fileType        IngestionFileType
  status          IngestionStatus    @default(pending)

  totalRows       Int?
  processedRows   Int?
  failedRows      Int?
  organizationsCreated Int?
  peopleCreated   Int?

  columnMap        String?             // JSON-encoded column mapping (structure varies by file format)

  errorMessage    String?
  errorDetails    String?             // JSON-encoded error array (truncated to first 100 errors for storage)

  storedFilePath  String?

  uploadedBy      String?
  uploadedAt      DateTime            @default(now())
  completedAt     DateTime?

  rows            DataIngestionRow[]

  @@index([status])
  @@index([uploadedAt])
}

model DataIngestionRow {
  id              String              @id @default(cuid())
  ingestionId     String
  ingestion       DataIngestion       @relation(fields: [ingestionId], references: [id], onDelete: Cascade)

  rawData         String
  rowNumber       Int

  organizationId  String?
  organization    Organization?      @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  personId        String?
  person          Person?             @relation(fields: [personId], references: [id], onDelete: SetNull)

  status          String              @default("pending")
  error           String?

  createdAt       DateTime            @default(now())

  @@index([ingestionId])
  @@index([organizationId])
  @@index([personId])
}

// ═══════════════════════════════════════════════════════════════════════════
// Knowledge Folders
// ═══════════════════════════════════════════════════════════════════════════

model KnowledgeFolder {
  id          String                    @id @default(cuid())
  name        String
  description String?
  color       String?
  icon        String?
  createdBy   String?
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt
  entities    KnowledgeFolderEntity[]

  @@index([createdBy])
}

model KnowledgeFolderEntity {
  id         String          @id @default(cuid())
  folderId   String
  folder     KnowledgeFolder @relation(fields: [folderId], references: [id], onDelete: Cascade)
  entityId   String
  entityType String           // 'organization' | 'person'
  addedBy    String?
  addedAt    DateTime         @default(now())

  @@unique([folderId, entityId, entityType])
  @@index([entityId, entityType])
}

// ═══════════════════════════════════════════════════════════════════════════
// Platform Users
// ═══════════════════════════════════════════════════════════════════════════

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  role          String    @default("user")
  passwordHash  String?
  otpCode       String?
  otpExpiresAt  DateTime?

  sessions      Session[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  resource  String?
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

// ═══════════════════════════════════════════════════════════════════════════
// AI Usage Logging
// ═══════════════════════════════════════════════════════════════════════════

model AIUsageLog {
  id              String    @id @default(cuid())
  provider        String
  model           String
  feature         String?
  promptTokens    Int       @default(0)
  completionTokens Int      @default(0)
  totalTokens     Int       @default(0)
  latencyMs       Int       @default(0)
  costUSD         Float     @default(0)
  qualityScore    Int?
  error           String?
  promptTemplateId String?
  createdAt       DateTime  @default(now())

  promptTemplate  PromptTemplate? @relation(fields: [promptTemplateId], references: [id], onDelete: SetNull)

  @@index([provider])
  @@index([feature])
  @@index([createdAt])
}

// ═══════════════════════════════════════════════════════════════════════════
// Prompt Template Registry
// ═══════════════════════════════════════════════════════════════════════════

model PromptTemplate {
  id            String   @id @default(cuid())
  key           String   @unique
  label         String
  description   String?

  systemPrompt  String
  userPromptTemplate String?

  version       Int      @default(1)
  isActive      Boolean  @default(true)
  isDefault     Boolean  @default(false)

  feature       String?
  model         String?

  createdBy     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  usageLogs     AIUsageLog[]

  @@index([key])
  @@index([feature])
  @@index([isActive])
  @@unique([key, version])
}
