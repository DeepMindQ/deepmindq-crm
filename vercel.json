{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build:vercel",
  "installCommand": "npm install",
  "regions": ["bom1"],
  "env": {
    "NEXT_TELEMETRY_DISABLED": "1"
  },
  "github": {
    "enabled": true,
    "autoAlias": true,
    "silent": true
  },
  "crons": [
    {
      "path": "/api/cron/job-processor",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/calibration-runner",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/persistence-evidence",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/persistence-performance",
      "schedule": "30 4 * * *"
    },
    {
      "path": "/api/cron/data-retention",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/backup-verify",
      "schedule": "0 3 1 * *"
    }
  ]
}
