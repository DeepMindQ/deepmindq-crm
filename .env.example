# ──────────────────────────────────────────────────────────────────────
#  DeepMindQ — Environment Variables
# ──────────────────────────────────────────────────────────────────────
# Copy this file to .env (local dev) OR paste these keys into Vercel
# Dashboard → Project → Settings → Environment Variables.
#
# All AI keys are OPTIONAL — engines degrade gracefully to template
# fallback if missing. Set what you have; the rest just won't run.
# ──────────────────────────────────────────────────────────────────────

# ── REQUIRED: Database (PostgreSQL) ──
# Get a free one from https://console.neon.tech (recommended for Vercel)
#
# LOCAL DEV:
#   DATABASE_URL=postgresql://user:pass@localhost:5432/deepmindq
#   DIRECT_DATABASE_URL=   (not needed for local dev)
#
# VERCEL / PRODUCTION (Neon):
#   DATABASE_URL=postgresql://neondb_owner:xxx@ep-xxx.aws.neon.tech/neondb?pgbouncer=true&sslmode=require
#   DIRECT_DATABASE_URL=postgresql://neondb_owner:xxx@ep-xxx.aws.neon.tech/neondb?sslmode=require
#
# On Vercel Dashboard → Settings → Environment Variables, set BOTH.
# The pgbouncer URL is for app queries (connection pooling).
# The direct URL is for Prisma migrations (needs raw TCP).
DATABASE_URL=
DIRECT_DATABASE_URL=

# ── REQUIRED in production: Auth secret ──
# Generate with: openssl rand -base64 32
#
# NOTE: SESSION_TOKEN_HMAC_SECRET is the preferred name (Milestone 1).
# NEXTAUTH_SECRET is accepted for backwards compatibility but is deprecated.
# If both are set, SESSION_TOKEN_HMAC_SECRET takes precedence.
SESSION_TOKEN_HMAC_SECRET=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# ── OPTIONAL: External Data Providers (M5 Phase 1) ──
# Required for verified company enrichment (TRUST framework).
# Without these, enrichment falls back to AI estimation (labeled as 'ai_estimated').
#
# Clearbit (PRIMARY) — Company data, tech stack, financial signals
# Free tier: 50 requests/month. Get from: https://clearbit.com
CLEARBIT_API_KEY=
#
# Apollo (FUTURE) — Contact/people enrichment
# Planned for Phase 1 completion.
# APOLLO_API_KEY=

# ── Zero-budget AI providers (NVIDIA primary, others fallback) ──
# All optional — engines degrade gracefully to template fallback if missing.
# Priority order: nvidia → fireworks → groq → gemini (set in ai-config.ts)

# NVIDIA NIM (PRIMARY) — Llama 3.1 8B Instruct, free credits ~40 RPM
# Get from: https://build.nvidia.com/ → sign in → API Keys → Generate
NVIDIA_API_KEY=

# Fireworks AI (BACKUP) — Llama 3.3 70B, free tier
# Get from: https://fireworks.ai/api → API Keys
FIREWORKS_API_KEY=

# Groq (FALLBACK) — Llama 3.3 70B, free tier (may block India IPs)
# Get from: https://console.groq.com/keys
GROQ_API_KEY=

# Google Gemini (FALLBACK) — Gemini 2.0 Flash, free tier (may block India IPs)
# Get from: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Tavily (WEB SEARCH) — Free 1000 searches/month
# Get from: https://app.tavily.com/ → API Keys
TAVILY_API_KEY=

# ── OPTIONAL: Transactional email (Resend) ──
# Required for: OTP login codes, notification emails, sequence emails.
# Without these, login will fail (OTP can't be delivered).
#
# Get RESEND_API_KEY from: https://resend.com/api-keys
# Format: re_xxxxxxxxxxxxx
#
# EMAIL_FROM must be on a domain you've verified in Resend dashboard.
# For first-time testing without domain verification, use:
#   EMAIL_FROM=onboarding@resend.dev
# (Resend's sandbox address — only sends to YOUR account email)
EMAIL_PROVIDER=resend
EMAIL_API_KEY=
EMAIL_FROM=

# ── REQUIRED in production: Authorized admin email ──
# This is the single email allowed to log in/register.
# For enterprise deployments, set this to the customer's admin email.
AUTHORIZED_EMAIL=

# ── REQUIRED in production: Tracking secret ──
# HMAC secret for email tracking (open/click) token signing.
# Generate with: openssl rand -hex 32
TRACKING_SECRET=

# ── Webhook & Cron secrets ──
# CRON_SECRET: Bearer token for Vercel Cron authentication
# Generate with: openssl rand -hex 32
CRON_SECRET=

# RESEND_WEBHOOK_SECRET: HMAC signing secret for Resend webhooks
# Get from: Resend Dashboard → Webhooks → Signing Key
RESEND_WEBHOOK_SECRET=

# SETUP_TOKEN: One-time token for /api/setup-db initial database setup
# Generate with: openssl rand -hex 32
SETUP_TOKEN=

# ── Public URLs (client-exposed) ──
# NEXT_PUBLIC_APP_URL: Public base URL for email links, tracking pixels, etc.
# Example: https://app.customerdomain.com
NEXT_PUBLIC_APP_URL=

# ── Sentry Error Tracking (optional) ──
# Get DSN from: https://sentry.io/ → Projects → Project Settings → Client Keys
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# ── REQUIRED in production: API Key Encryption ──
# AES-256-GCM encryption key for AI provider API keys stored in the database.
# WITHOUT THIS KEY, API keys are stored in PLAINTEXT — a security risk.
# Generate with: openssl rand -base64 32
API_KEY_ENCRYPTION_KEY=

# ── OPTIONAL: File attachments storage ──
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ── WI-18.2: Intelligence Persistence Engine ──
# Controls DB-backed persistence for AI intelligence (knowledge graph, memory, retrieval).
# All flags default to false/conservative — persistence is off by default.
#
# USE_DB_PERSISTENCE=true   — Master switch: enables DB writes behind existing Map operations.
#                               When false, AI uses Map-only mode (existing behavior, zero risk).
# PERSISTENCE_SHADOW_MODE=true — Shadow mode: Map remains authoritative, DB writes happen in
#                               parallel for validation. Use during migration to compare Map vs DB.
# COMPANY_ID=               — Single-tenant mode: loads only global + this company's data.
#                               When unset, multi-tenant SaaS mode (all data loaded, runtime filters).
# PERSISTENCE_REQUIRE_FULL_LOAD=false — Cold start: allow degraded mode if not all stores load.
#                                       Default: true (require full load).
# PERSISTENCE_MAX_LOAD_TIME_MS=120000 — Maximum cold start load time in ms (default: 60000).
# PERSISTENCE_DEGRADED_THRESHOLD=0.7   — Completeness ratio below which cold start is degraded (default: 0.8).
USE_DB_PERSISTENCE=false
PERSISTENCE_SHADOW_MODE=false
