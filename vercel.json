{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build:vercel",
  "installCommand": "npm install",
  "regions": ["bom1"],
  "env": {
    "NEXT_TELEMETRY_DISABLED": "1"
  },
  "github": {
    "enabled": true,
    "autoAlias": true,
    "silent": true
  },
  "crons": [
    {
      "path": "/api/cron/job-processor",
      "schedule": "0 6 * * *"
    }
  ]
}
