{
  "name": "nextjs_tailwind_shadcn_ts",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "unset DATABASE_URL && NODE_OPTIONS='--max-old-space-size=2048' next dev -p 3000 -H 0.0.0.0 2>&1 | tee dev.log",
    "dev:prod": "unset DATABASE_URL && npm run build && DATABASE_URL=$(grep '^DATABASE_URL=' .env | cut -d= -f2-) next start -p 3000 -H 0.0.0.0 2>&1 | tee dev.log",
    "build": "npx prisma generate && npx prisma migrate deploy --skip-generate && npx next build",
    "build:vercel": "npx prisma generate && npx next build",
    "start": "unset DATABASE_URL && next start -p ${PORT:-3000} -H 0.0.0.0",
    "lint": "eslint . && bash scripts/check-governance.sh",
    "check:governance": "bash scripts/check-governance.sh",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:reset": "prisma migrate reset",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "postinstall": "npx prisma generate",
    "vercel-build": "npx prisma generate && npx next build",
    "cloud:setup": "bash scripts/setup-cloud.sh",
    "cloud:migrate": "node scripts/migrate-to-postgres.js",
    "cloud:export": "node scripts/export-seed-data.js",
    "prepare": "husky"
  },
  "dependencies": {
