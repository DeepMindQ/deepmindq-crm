// Stores LLM-generated strategic insights for each company.
// Produced by the Reasoning Engine (gatherReasoningContext → buildPrompt → LLM → parse → persist).
// Each insight has an expiry window and full reasoning chain for explainability.

model StrategicInsight {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  insightType        String // STRATEGIC_SHIFT | OPPORTUNITY | RISK | PATTERN_EMERGED
  summary            String // concise human-readable insight summary
  keyThemes          Json    @default("[]") // JSON: string[]
  reasoningSummary   Json    @default("{}") // JSON: { observations: string[], interpretation: string, confidenceFactors: string[] }
  supportingEvidence Json    @default("[]") // JSON: { evidenceId: string, relevance: string, quote: string }[]
  confidenceScore    Int    @default(0) // 0-100

  generatedBy String    @default("LLM") // LLM | HYBRID | MANUAL
  modelUsed   String?
  expiresAt   DateTime?
  generatedAt DateTime  @default(now())

  engagementStrategies AIEngagementStrategy[]

  @@index([companyId])
  @@index([insightType])
  @@index([confidenceScore])
  @@index([generatedAt])
  @@index([companyId, generatedAt(sort: Desc)])
}

// Stores LLM-generated engagement strategies linked to a strategic insight.
// Produced by the Strategy Generator (buildStrategyPrompt → LLM → parse → persist).
// Includes conversation angles, risk factors, and recommended entry points.

