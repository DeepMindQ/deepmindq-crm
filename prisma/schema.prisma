  recommendedEntry      Json    @default("{}") // JSON: { role, rationale, department }
  firstMeetingObjective String @default("discovery") // discovery | technical | executive_alignment
  conversationAngles    Json    @default("[]") // JSON: { angle, talkingPoints: string[] }[]
  riskFactors           Json    @default("[]") // JSON: { risk, severity, mitigation }[]
  priorityScore         Int    @default(0) // 0-100

  generatedBy String    @default("LLM")
  modelUsed   String?
  expiresAt   DateTime?
  generatedAt DateTime  @default(now())

  @@index([companyId])
  @@index([strategicInsightId])
  @@index([priorityScore])
  @@index([generatedAt])
  @@index([companyId, generatedAt(sort: Desc)])
}

// ═══════════════════════════════════════════════════════════════════════
