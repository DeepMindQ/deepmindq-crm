# ──────────────────────────────────────────────────────────────────────
#  DeepMindQ — Environment Variables
# ──────────────────────────────────────────────────────────────────────
# Copy this file to .env (local dev) OR paste these keys into Vercel
# Dashboard → Project → Settings → Environment Variables.
#
# All AI keys are OPTIONAL — engines degrade gracefully to template
# fallback if missing. Set what you have; the rest just won't run.
# ──────────────────────────────────────────────────────────────────────

# ── REQUIRED: Database (PostgreSQL) ──
# Get a free one from https://console.neon.tech (recommended for Vercel)
#
# LOCAL DEV:
#   DATABASE_URL=postgresql://user:pass@localhost:5432/deepmindq
#   DIRECT_DATABASE_URL=   (not needed for local dev)
#
# VERCEL / PRODUCTION (Neon):
#   DATABASE_URL=postgresql://neondb_owner:xxx@ep-xxx.aws.neon.tech/neondb?pgbouncer=true&sslmode=require
#   DIRECT_DATABASE_URL=postgresql://neondb_owner:xxx@ep-xxx.aws.neon.tech/neondb?sslmode=require
#
# On Vercel Dashboard → Settings → Environment Variables, set BOTH.
# The pgbouncer URL is for app queries (connection pooling).
# The direct URL is for Prisma migrations (needs raw TCP).
DATABASE_URL=
DIRECT_DATABASE_URL=

# ── REQUIRED in production: Auth secret ──
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# ── Zero-budget AI providers (NVIDIA primary, others fallback) ──
# All optional — engines degrade gracefully to template fallback if missing.
# Priority order: nvidia → fireworks → groq → gemini (set in ai-config.ts)

# NVIDIA NIM (PRIMARY) — Llama 3.1 8B Instruct, free credits ~40 RPM
# Get from: https://build.nvidia.com/ → sign in → API Keys → Generate
NVIDIA_API_KEY=

# Fireworks AI (BACKUP) — Llama 3.3 70B, free tier
# Get from: https://fireworks.ai/api → API Keys
FIREWORKS_API_KEY=

# Groq (FALLBACK) — Llama 3.3 70B, free tier (may block India IPs)
# Get from: https://console.groq.com/keys
GROQ_API_KEY=

# Google Gemini (FALLBACK) — Gemini 2.0 Flash, free tier (may block India IPs)
# Get from: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Tavily (WEB SEARCH) — Free 1000 searches/month
# Get from: https://app.tavily.com/ → API Keys
TAVILY_API_KEY=

# ── OPTIONAL: Transactional email (Resend) ──
# Required for: OTP login codes, notification emails, sequence emails.
# Without these, login will fail (OTP can't be delivered).
#
# Get RESEND_API_KEY from: https://resend.com/api-keys
# Format: re_xxxxxxxxxxxxx
#
# EMAIL_FROM must be on a domain you've verified in Resend dashboard.
# For first-time testing without domain verification, use:
#   EMAIL_FROM=onboarding@resend.dev
# (Resend's sandbox address — only sends to YOUR account email)
EMAIL_PROVIDER=resend
EMAIL_API_KEY=
EMAIL_FROM=

# ── OPTIONAL: File attachments storage ──
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
