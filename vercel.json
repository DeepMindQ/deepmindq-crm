{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["bom1"],
  "env": {
    "NEXT_TELEMETRY_DISABLED": "1"
  },
  "github": {
    "enabled": true,
    "autoAlias": true,
    "silent": true
  },
  "crons": [
    {
      "path": "/api/cron/job-processor",
      "schedule": "0 6 * * *"
    }
  ],
  "services": {
    "deepmindq-crm": {
      "root": ".",
      "framework": "nextjs",
      "buildCommand": "npm install && npm run build:vercel"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "deepmindq-crm"
      }
    }
  ]
}
